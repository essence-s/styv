---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout
  title="404 | Página no encontrada"
  description="La página que buscas no existe o fue movida."
  noindex
>
  <main class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">Página no encontrada</h1>
    <p class="not-found__text">
      La página que buscas no existe o fue movida.
    </p>
    <a class="not-found__link" href={base}>Volver al inicio</a>
  </main>
</Layout>

<style>
  .not-found {
    min-height: calc(100vh - 150px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 48px 24px;
    text-align: center;
    color: var(--color-text);
    background: linear-gradient(281deg, #19191a, #1a1a1c);
    font-family: var(--font-family-1);
  }

  .not-found__code {
    margin: 0;
    font-family: var(--font-family);
    font-size: clamp(6rem, 20vw, 12rem);
    line-height: 0.8;
    color: var(--color-button);
  }

  .not-found__title {
    margin: 0;
    font-family: var(--font-family);
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-title);
  }

  .not-found__text {
    margin: 0 0 16px;
    color: var(--color-text-2);
  }

  .not-found__link {
    padding: 10px 18px;
    border: 1px solid #ffffff17;
    border-radius: 6px;
    background: linear-gradient(90deg, #0000001c, #00000021);
    box-shadow: 2px 2px 3px 0 #0000001f;
    color: var(--color-text);
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .not-found__link:hover {
    background: linear-gradient(90deg, #00000077, #00000079);
    color: var(--color-button);
  }
</style>
