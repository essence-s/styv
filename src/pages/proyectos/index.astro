---
import Layout from '../../layouts/Layout.astro';
import PageTopbar from '../../components/projects/PageTopbar.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import {
  CATALOG_PROJECTS,
  PROJECTS,
  PROJECT_TYPE_COUNTS,
  PROJECT_TYPE_LABELS,
  type ProjectType,
} from '../../data/projects';
import { withBase } from '../../utils/routes';

const filters: Array<{ key: 'all' | ProjectType; label: string; count: number }> = [
  { key: 'all', label: 'Todos', count: PROJECTS.length },
  { key: 'interface', label: 'Interfaces', count: PROJECT_TYPE_COUNTS.interface ?? 0 },
  { key: 'web', label: 'Webs', count: PROJECT_TYPE_COUNTS.web ?? 0 },
  { key: 'app', label: 'Apps', count: PROJECT_TYPE_COUNTS.app ?? 0 },
  { key: 'bot', label: 'Bots', count: PROJECT_TYPE_COUNTS.bot ?? 0 },
];
---

<Layout
  title='Proyectos | Styv'
  description='Catálogo de proyectos de Styven: interfaces de escritorio, webs, aplicaciones y bots.'
>
  <PageTopbar />

  <main class='catalog'>
    <div class='catalog__container'>
      <header class='catalog__head'>
        <div>
          <p class='catalog__eyebrow'>Archivo completo</p>
          <h1 class='catalog__title'>Todos los proyectos</h1>
        </div>
        <div class='catalog__head-side'>
          <p class='catalog__intro'>
            Una vista completa de lo que he construido. Filtra por tipo o entra
            a cada ficha para ver el contexto, los módulos y las decisiones
            técnicas.
          </p>
          <p class='catalog__count'>
            <span data-visible-count>{PROJECTS.length}</span>
            <span>proyectos</span>
          </p>
        </div>
      </header>

      <div class='catalog__filters' role='group' aria-label='Filtrar proyectos por tipo'>
        {
          filters.map((filter, index) => (
            <button
              type='button'
              class:list={['filter-chip', { 'is-active': index === 0 }]}
              data-filter={filter.key}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span>{filter.label}</span>
              <span class='filter-chip__count'>{filter.count}</span>
            </button>
          ))
        }
      </div>

      <div class='catalog__grid'>
        {
          CATALOG_PROJECTS.map((project) => (
            <div class='catalog__item' data-project-type={project.type}>
              <ProjectCard project={project} variant='vertical' />
            </div>
          ))
        }
      </div>

      <div class='catalog__empty' data-empty hidden>
        <p>No hay proyectos en esta categoría todavía.</p>
        <button type='button' data-reset>Ver todos</button>
      </div>

      <footer class='catalog__footer'>
        <span>¿Buscas algo en concreto?</span>
        <a href={`mailto:styv2301@gmail.com`}>Hablemos</a>
      </footer>
    </div>
  </main>
</Layout>

<script data-astro-rerun>
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-filter]')
  );
  const items = Array.from(
    document.querySelectorAll<HTMLElement>('[data-project-type]')
  );
  const visibleCount = document.querySelector<HTMLElement>('[data-visible-count]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-reset]');
  const validFilters = new Set(filterButtons.map((button) => button.dataset.filter));

  const applyFilter = (filter: string, updateUrl = true) => {
    const activeFilter = validFilters.has(filter) ? filter : 'all';
    let visible = 0;

    items.forEach((item) => {
      const show =
        activeFilter === 'all' || item.dataset.projectType === activeFilter;
      item.hidden = !show;
      if (show) visible += 1;
    });

    filterButtons.forEach((button) => {
      const isActive = button.dataset.filter === activeFilter;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });

    if (visibleCount) visibleCount.textContent = String(visible);
    if (emptyState) emptyState.hidden = visible > 0;

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (activeFilter === 'all') {
        url.searchParams.delete('tipo');
      } else {
        url.searchParams.set('tipo', activeFilter);
      }
      window.history.replaceState({}, '', url);
    }
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'));
  });

  resetButton?.addEventListener('click', () => applyFilter('all'));

  const initialFilter = new URLSearchParams(window.location.search).get('tipo') ?? 'all';
  applyFilter(initialFilter, false);
</script>

<style>
  .catalog {
    min-height: calc(100vh - 65px);
    color: var(--color-text);
    background:
      radial-gradient(50% 40% at 80% 0%, #ef877e0b, transparent 60%),
      linear-gradient(281deg, #19191a, #1a1a1c);
    font-family: var(--font-family-1);
  }

  .catalog__container {
    width: 100%;
    max-width: 1200px;
    margin: auto;
    padding: 90px 60px 100px;
  }

  .catalog__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 42px;
    padding-bottom: 30px;
    border-bottom: 1px solid #ffffff0f;
  }

  .catalog__eyebrow {
    margin: 0 0 8px;
    color: var(--color-button);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .catalog__title {
    margin: 0;
    font-family: var(--font-family);
    font-size: clamp(3rem, 7vw, 5.2rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 0.86;
    text-transform: uppercase;
  }

  .catalog__head-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    max-width: 430px;
    text-align: right;
  }

  .catalog__intro {
    margin: 0;
    color: #b7b8bf;
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .catalog__count {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
    color: #8f9098;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .catalog__count span:first-child {
    color: #ffc1bb;
    font-family: var(--font-family);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
  }

  .catalog__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 26px 0 28px;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid #ffffff14;
    border-radius: 999px;
    background: linear-gradient(271deg, #ffffff0a, #ffffff04);
    color: #b9bac1;
    font-family: var(--font-family-1);
    font-size: 0.76rem;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .filter-chip:hover {
    border-color: #ffffff2b;
    color: #f0f0f2;
  }

  .filter-chip.is-active {
    border-color: #ef877e66;
    background: #ef877e17;
    color: #ffd0cb;
  }

  .filter-chip__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 999px;
    background: #ffffff0d;
    color: #92939c;
    font-size: 0.64rem;
  }

  .filter-chip.is-active .filter-chip__count {
    background: #ef877e24;
    color: #ffc1bb;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .catalog__item[hidden] {
    display: none;
  }

  .catalog__empty {
    padding: 70px 20px;
    border: 1px dashed #ffffff1a;
    border-radius: 12px;
    color: #9d9ea7;
    text-align: center;
  }

  .catalog__empty p {
    margin: 0 0 14px;
  }

  .catalog__empty button {
    padding: 8px 14px;
    border: 1px solid #ef877e55;
    border-radius: 6px;
    background: #ef877e14;
    color: #ffc1bb;
    font-family: var(--font-family-1);
    cursor: pointer;
  }

  .catalog__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 50px;
    padding-top: 22px;
    border-top: 1px solid #ffffff0f;
    color: #8f9098;
    font-size: 0.8rem;
  }

  .catalog__footer a {
    color: #f0d7d3;
    text-decoration: none;
    border-bottom: 1px solid #ef877e55;
  }

  .catalog__footer a:hover {
    color: var(--color-button);
  }

  @media (max-width: 1080px) {
    .catalog__container {
      padding: 80px 40px;
    }

    .catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .catalog__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .catalog__head-side {
      align-items: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .catalog__container {
      padding: 60px 20px 80px;
    }

    .catalog__grid {
      grid-template-columns: 1fr;
    }

    .catalog__footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
